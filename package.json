{
  "name": "waifu-orchestrator",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KJ5678943/Discord-Waifus.git"
  },
  "homepage": "https://github.com/KJ5678943/Discord-Waifus",
  "bugs": {
    "url": "https://github.com/KJ5678943/Discord-Waifus/issues"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter dashboard dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build": "pnpm --filter backend build && pnpm --filter dashboard build && pnpm --filter @starlight-ai/discord-waifus build",
    "start": "pnpm --filter backend start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
